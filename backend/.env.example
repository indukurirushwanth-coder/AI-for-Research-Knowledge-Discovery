# =====================================================================
# ResearchLens AI - Backend Environment Configuration Template
# Copy this file to .env and supply your credentials
# =====================================================================

PORT=5000
CLIENT_URL=http://localhost:5173

# Supabase / PostgreSQL Connection String
# Example: postgresql://postgres.xxxx:password@aws-0-us-east-1.pooler.supabase.com:6543/postgres
# If left empty, server automatically runs with local persistence for development testing
DATABASE_URL=

# JWT Secret for Session Signing
JWT_SECRET=researchlens_super_secret_jwt_key_hackathon_2026_change_in_production

# Google Gemini API Key (Get at https://aistudio.google.com/)
GEMINI_API_KEY=

# Google Gemini Model Identifier (Default: gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash
